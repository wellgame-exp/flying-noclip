	end
end)

--// Core Action: Perform Teleport Down Once (With 1-Second Noclip)
local function executeTeleportDownOnce()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then 
		notify("TeleKill", "Character not ready")
		return 
	end

	local targets = getTargetPlayers()
	if #targets == 0 then
		notify("TeleKill", "No targets found/matched")
		return
	end

	local originalCFrame = root.CFrame

	task.spawn(function()
		-- Enable Noclip for 1 second by setting CanCollide = false on character parts
		pcall(function()
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end)

		for _, target in ipairs(targets) do
			local targetCharacter = target.Character
			local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
			if targetRoot then
				local startTime = os.clock()
				while os.clock() - startTime < SPIN_DURATION do
					local activeChar = player.Character
					local activeRoot = activeChar and activeChar:FindFirstChild("HumanoidRootPart")
					if not activeRoot then break end

					spinAngle = spinAngle + math.rad(180)
					pcall(function()
						activeRoot.Velocity = Vector3.new(0, 0, 0)
						activeRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
						activeRoot.CFrame = targetRoot.CFrame * CFrame.new(0, -4, 0) * CFrame.Angles(math.rad(90), 0, spinAngle)
					end)
					task.wait(0.01)
				end
			end
		end

		-- Return to original position
		if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local finalRoot = player.Character.HumanoidRootPart
			pcall(function()
				finalRoot.Velocity = Vector3.new(0, 0, 0)
				finalRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
				finalRoot.CFrame = originalCFrame
			end)
		end

		-- Wait for the 1-second noclip duration to pass, then restore collision
		task.wait(0.5)
		pcall(function()
			if player.Character then
				for _, part in ipairs(player.Character:GetDescendants()) do
					if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
						part.CanCollide = true
					end
				end
			end
		end)
	end)
end

--// Core Action: Perform Teleport Once (Super Fast Spin)
local function executeTeleportOnce()
	if teleportDownUnderActive then
		executeTeleportDownOnce()
		return
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then 
		notify("TeleKill", "Character not ready")
		return 
	end

	local targets = getTargetPlayers()
	if #targets == 0 then
		notify("TeleKill", "No targets found/matched")
		return
	end

	local originalCFrame = root.CFrame

	task.spawn(function()
		for _, target in ipairs(targets) do
			local targetCharacter = target.Character
			local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
			if targetRoot then
				local startTime = os.clock()
				while os.clock() - startTime < SPIN_DURATION do
					local activeChar = player.Character
					local activeRoot = activeChar and activeChar:FindFirstChild("HumanoidRootPart")
					if not activeRoot then break end

					spinAngle = spinAngle + math.rad(180)
					pcall(function()
						activeRoot.Velocity = Vector3.new(0, 0, 0)
						activeRoot.CFrame = targetRoot.CFrame * CFrame.new(3, 0, 0) * CFrame.Angles(0, spinAngle, 0)
					end)
					task.wait(0.01)
				end
			end
		end

		if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local finalRoot = player.Character.HumanoidRootPart
			pcall(function()
				finalRoot.Velocity = Vector3.new(0, 0, 0)
				finalRoot.CFrame = originalCFrame
			end)
		end
	end)
end

