--// Helper: Apply Theme & Color Changes
local function applyThemeAndColor(themeName, hexStr)
	local col = hexToColor3(hexStr)
	pcall(function()
		if themeName and Window.SetTheme then
			Window:SetTheme(themeName)
		elseif themeName and WindUI.SetTheme then
			WindUI:SetTheme(themeName)
		end
	end)

	if col then
		pcall(function()
			if Window.OpenButton and Window.OpenButton.Color then
				Window.OpenButton.Color = ColorSequence.new(col, Color3.fromHex("#e7ff2f"))
			end
		end)
		pcall(function()
			if WindUI.SetAccentColor then
				WindUI:SetAccentColor(col)
			end
		end)
	end
end

--// Helper: Re-Execute Script Safely
local function reExecuteScript()
	-- Stop active loops before re-executing
	loopTeleporting = false
	teleportAllActive = false
	teleportUnderAllActive = false
	teleportUnderToggleActive = false
	autoClickActive = false

	pcall(function()
		if Window.Destroy then
			Window:Destroy()
		end
	end)

	task.spawn(function()
		task.wait(0.15)
		if SCRIPT_URL and SCRIPT_URL ~= "" then
			local ok, err = pcall(function()
				loadstring(game:HttpGet(SCRIPT_URL))()
			end)
			if not ok then
				warn("Re-execute failed: " .. tostring(err))
			end
		elseif cachedSource and type(cachedSource) == "string" and cachedSource ~= "" then
			local ok, err = pcall(function()
				loadstring(cachedSource)()
			end)
			if not ok then
				warn("Re-execute cached source failed: " .. tostring(err))
			end
		else
			notify("Setting", "Set SCRIPT_URL at top of script or run via loadstring to enable instant re-execute.")
		end
	end)
end

